# Mezo RePay keeper. Copy to .env (never commit it).
MEZO_RPC_URL=https://rpc.test.mezo.org
# Testnet-only key that pays keeper gas. It has NO authority over accounts: executeRepayment is
# permissionless and bounded by each account's on-chain policy. Leave empty for read-only dry-run.
KEEPER_PRIVATE_KEY=
# live | dry-run
KEEPER_MODE=dry-run
KEEPER_POLL_SECONDS=60
KEEPER_PORT=8787
KEEPER_STATE_DIR=./state
# Optional: restrict to a single account
KEEPER_ACCOUNT=
