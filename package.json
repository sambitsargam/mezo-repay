{
  "name": "mezo-repay",
  "private": true,
  "packageManager": "pnpm@8.15.4",
  "engines": { "node": ">=20" },
  "scripts": {
    "abi": "node scripts/export-abis.mjs",
    "contracts:build": "cd packages/contracts && forge build",
    "contracts:test": "cd packages/contracts && forge test",
    "contracts:fork": "cd packages/contracts && MEZO_FORK=1 forge test --match-contract MezoForkTest -vv",
    "dev": "pnpm --filter @repay/web dev",
    "build": "pnpm --filter @repay/web build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "keeper": "pnpm --filter @repay/keeper start"
  }
}
